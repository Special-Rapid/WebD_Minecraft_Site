{
  "$schema": "https://unpkg.com/wrangler@4.95.0/config-schema.json",
  "name": "upload-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "api.snkisk.com",
      "zone_name": "snkisk.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "images"
    }
  ],
  "vars": {
    "UPLOAD_UI_URL": "https://mc.snkisk.com/",
    "R2_PUBLIC_BASE_URL": "https://pub-20b6359682f5478c96f1a1097e616fa9.r2.dev",
    "CUSTOM_PUBLIC_BASE_URL": "https://images.snkisk.com"
  }
}
